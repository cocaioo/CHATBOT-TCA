# Copie para .env e ajuste. O .env não é versionado: a chave do Gemini nunca vai para o GitHub.

DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5434/chatbot

# true em produção (exige HTTPS). Navegadores aceitam cookie Secure em http://localhost.
COOKIE_SECURE=true

# Modelo: Gemini 2.5 Flash, pelo SDK oficial do Google (google-genai).
# Gere a chave em https://aistudio.google.com/apikey
LLM_PROVEDOR=gemini
GEMINI_API_KEY=
LLM_MODELO=gemini-2.5-flash

# Opcionais
# LLM_TIMEOUT_SEGUNDOS=90
# Tokens de "raciocínio" do modelo: 0 desliga (respostas começam mais cedo), -1 automático.
# LLM_ORCAMENTO_RACIOCINIO=0

# "falso" = modelo simulado (só repete a pergunta), usado nos testes automatizados.
# LLM_PROVEDOR=falso
