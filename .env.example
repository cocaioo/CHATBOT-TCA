# Copie para .env e ajuste. O .env não é versionado.

DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5434/chatbot

# true em produção (exige HTTPS). Navegadores aceitam cookie Secure em http://localhost.
COOKIE_SECURE=true

# "falso" = modelo simulado; "openai" = API compatível com a da OpenAI (Qwen 3)
LLM_PROVEDOR=falso
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODELO=qwen3
# Exemplo com Ollama local:
#   LLM_PROVEDOR=openai
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
#   LLM_MODELO=qwen3:0.6b
#   LLM_EXTRA_BODY={"reasoning_effort": "none"}
# Parâmetros extras do provedor, em JSON. Ex. para desligar o modo de raciocínio do Qwen 3:
#   Ollama:     {"reasoning_effort": "none"}
#   DashScope:  {"enable_thinking": false}
#   vLLM:       {"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY={}
